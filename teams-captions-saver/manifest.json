{
  "manifest_version": 3,
  "name": "Live Captions Saver - Teams, Meet & Zoom",
  "version": "5.4.0",
  "description": "Capture and save live captions from Microsoft Teams, Google Meet, and Zoom. Features include various save formats, AI summaries, and automation.",
  "homepage_url": "https://spdenis.com",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },

  "permissions": [
    "downloads",
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*",
    "https://meet.google.com/*",
    "https://web.zoom.us/*",
    "https://app.zoom.us/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.live.com/*",
    "https://outlook.cloud.microsoft/*",
    "https://*.sharepoint.com/*",
    "https://www.office.com/*",
    "https://login.microsoftonline.com/*",
    "https://login.live.com/*",
    "https://login.microsoft.com/*"
  ],

  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html",
    "default_title": "Teams Captions Saver"
  },

  "background": {
    "service_worker": "service_worker.js"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },

  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://meet.google.com/*",
        "https://web.zoom.us/*",
        "https://app.zoom.us/*"
      ],
      "js": [
        "platformConfig.js",
        "keywordEngine.js",
        "slideCapture.js",
        "content_script.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "https://*.officeapps.live.com/*"
      ],
      "js": [
        "pptLiveDpr.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.officeapps.live.com/*"
      ],
      "js": [
        "slideCapture.js",
        "pptLiveCapture.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://*.sharepoint.com/*",
        "https://www.office.com/*",
        "https://login.microsoftonline.com/*",
        "https://login.live.com/*",
        "https://login.microsoft.com/*"
      ],
      "js": [
        "m365_keepalive.js"
      ],
      "all_frames": true
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html",
        "viewer.js",
        "keywordEngine.js",
        "sessionManager.js",
        "transcript_interceptor.js",
        "visibility_shim.js"
      ],
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://meet.google.com/*",
        "https://web.zoom.us/*",
        "https://app.zoom.us/*"
      ]
    }
  ]
}
